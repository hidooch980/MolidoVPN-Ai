<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <application
        android:name=".MolidoVpnApplication"
        android:allowBackup="false"
        android:label="MolidoVPN AI"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Internal PackageInstaller result callback; never exported to other apps. -->
        <receiver
            android:name=".UpdateInstallStatusReceiver"
            android:exported="false" />
        <!-- Native Go engines are isolated from one another to avoid multiple Go runtimes in one process.
             These private IPC services are NOT VPNServices and do not own/create a TUN. -->
        <service
            android:name=".engine.process.XrayEngineProcessService"
            android:exported="false"
            android:process=":engine_xray" />
        <service
            android:name=".engine.process.AmneziaEngineProcessService"
            android:exported="false"
            android:process=":engine_amneziawg" />
        <service
            android:name=".engine.process.PsiphonEngineProcessService"
            android:exported="false"
            android:process=":engine_psiphon" />
        <!-- The WireGuard AAR merges GoBackend.VpnService as the sole VPN service/TUN provider. -->
    </application>
</manifest>
